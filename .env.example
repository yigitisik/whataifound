# Copy to .env.local for `vercel dev`, and set the same names in the Vercel project
# settings for preview and production. .env* is gitignored except this file.
#
# Nothing here is ever sent to a browser. The site talks only to /api/* on its own
# origin, which is what keeps the CSP at `connect-src 'self'`.

# ---- Google OAuth (OpenID Connect) ----------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client ID
#   Application type:      Web application
#   Authorised redirect:   https://whataifound.org/api/auth/callback
#                          http://localhost:8000/api/auth/callback   (for local dev)
# Only the `openid email profile` scopes are requested. No Drive, no Gmail, nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Database (Supabase Postgres) -----------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> "Transaction pooler".
# Use the POOLER url (port 6543), not the direct one: a serverless function opens a new
# connection per cold start and would exhaust a direct Postgres in minutes.
DATABASE_URL=

# ---- Session signing ------------------------------------------------------
# Any long random string. Rotating it signs every existing session out, which is the
# intended emergency lever. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---- Site origin ----------------------------------------------------------
# Used to build the OAuth redirect_uri and to reject open redirects on sign-in.
# Leave unset locally and it falls back to the request's own origin.
SITE_ORIGIN=https://whataifound.org

# ---- GitHub App (the submission bot) --------------------------------------
# Optional. Without these the site runs exactly as it does with them, except that
# approving a submission in /admin cannot open a pull request and says so. Everything
# else (signing in, signals, submitting, rejecting) works.
#
# github.com/settings/apps -> New GitHub App, installed on this repository only.
# Repository permissions, and nothing more:
#     Contents        Read and write    (to push a submission branch)
#     Pull requests   Read and write    (to open the pull request)
# Do NOT grant Actions, Workflows or Administration. The branch this App pushes is
# rebuilt by .github/workflows/rebuild-bot.yml, and an App that could edit workflows
# could rewrite the check that constrains it.
GH_APP_ID=
# The .pem from "Generate a private key", whole. Newlines may be real or escaped as \n.
GH_APP_PRIVATE_KEY=
# Settings -> Install App -> the number at the end of the installation's URL.
GH_INSTALLATION_ID=
GH_REPO=yigitisik/whataifound
# The branch pull requests target. Defaults to main.
GH_BASE_BRANCH=main
